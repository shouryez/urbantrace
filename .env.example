# Copy to .env.local and fill in. Never commit .env.local.
OLLAMA_URL=http://localhost:11434
# Gemma 4 E4B for the hackathon; gemma4:e2b (fallback) and qwen3-vl:8b-instruct also work
VISION_MODEL=gemma4:e4b
EMBED_MODEL=nomic-embed-text
ML_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never sent to the browser
NOMINATIM_USER_AGENT="UrbanTrace/0.1 (team email)"
# Optional: the site address used in complaint letters drafted by scripts/seed-demo.ts
# SEED_ORIGIN=http://localhost:3000
# Passcode for the authority console (/authority); leave empty to turn the console off
AUTHORITY_PASSCODE=

# Optional: hosted Gemma through Google AI Studio (https://aistudio.google.com/apikey).
# When set, model calls go here first and fall back to local Ollama on failure.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# Optional: Sarvam AI speech to text for voice notes (https://dashboard.sarvam.ai). Falls back to Whisper.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
